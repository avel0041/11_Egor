   "source": [
    "f=open('24 (1).txt').readline()\n",
    "m=0\n",
    "l = 0\n",
    "k9 = 0\n",
    "\n",
    "for r in range(1, len(f)):\n",
    "    if f[r-1:r+1]=='K9':\n",
    "        k9+=1\n",
    "    while k9>150:\n",
    "        if f[l-1:l+1]=='K9':\n",
    "            k9-=1\n",
    "        l+=1\n",
    "    m = max(m, r-l+2)\n",
    "print(m)"
   ]
  }
